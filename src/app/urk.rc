// urk.exe resources. The manifest comes from urk.manifest in the target sources, so wx.rc must not add one.
#define wxUSE_NO_MANIFEST 1
#include "wx/msw/wx.rc"

// Named so it sorts before wx's icons; Explorer shows the first one.
urk_app ICON "urk.ico"

1 VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jadis0x"
            VALUE "FileDescription", "URKit"
            VALUE "FileVersion", "0.5.0"
            VALUE "InternalName", "urk"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "urk.exe"
            VALUE "ProductName", "URKit"
            VALUE "ProductVersion", "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
